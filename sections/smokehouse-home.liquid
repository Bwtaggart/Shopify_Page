      <div style="text-align:right">
        <div class="sm-eye" style="font-size:10px">Heat</div>
        <div style="font-family:var(--sm-f-display); font-size:26px; color:var(--sm-cream); margin-top:8px">Hot · 8 of 10</div>
      </div>
      <div style="text-align:right">
        <div class="sm-eye" style="font-size:10px">Net weight</div>
        <div style="font-family:var(--sm-f-display); font-size:26px; color:var(--sm-cream); margin-top:8px">16 oz · 454 g</div>
      </div>
    </div>
    <div style="position:relative; transform:translateY(-30px); padding:0 40px">
      <img src="https://cdn.shopify.com/s/files/1/0787/2010/6751/files/pepper_jar_500px.png?v=1766894002&width=400"
           alt="Hot Pepper Spread 16 oz jar"
           width="300" height="456"
           style="display:block; filter:drop-shadow(0 12px 24px rgba(0,0,0,0.4))">
    </div>
    <div style="display:grid; gap:36px">
      <div>
