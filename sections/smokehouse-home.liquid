        <div style="font-size:14px; margin-top:6px; color:var(--sm-cream-dim)">Field-grown, VA</div>
      </div>
      <div style="padding:26px; background:var(--sm-base)">
        <div style="font-family:var(--sm-f-ui); font-size:11px; letter-spacing:2px; color:var(--sm-gold)">02</div>
        <div style="font-family:var(--sm-f-display); font-size:21px; margin-top:10px; color:var(--sm-cream)">Hot peppers</div>
        <div style="font-size:14px; margin-top:6px; color:var(--sm-cream-dim)">Heirloom, spicy</div>
