<section class="hero" style="--hero-overlay: {{ section.settings.overlay_color }};">
  {% if section.settings.background != blank %}
    <div class="hero__media">
      {{ section.settings.background | image_url: width: 2400 | image_tag: class: 'hero__image', loading: 'lazy', alt: section.settings.heading, widths: '1200,1600,2000,2400' }}
    </div>
  {% endif %}
  <div class="hero__content">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="lead">{{ section.settings.text }}</p>
    <div class="hero__buttons">
      {% if section.settings.primary_label != blank %}
        <a href="{{ section.settings.primary_link }}" class="button">{{ section.settings.primary_label }}</a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a href="{{ section.settings.secondary_link }}" class="button button--ghost">{{ section.settings.secondary_label }}</a>
      {% endif %}
    </div>
    <ul class="hero__stats">
      {% for block in section.blocks %}
        <li>
          <span class="hero__stat-label">{{ block.settings.label }}</span>
          <span class="hero__stat-value">{{ block.settings.value }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
  <div class="hero__jar">
    {% if section.settings.jar_image != blank %}
      {{ section.settings.jar_image | image_url: width: 900 | image_tag: class: 'hero__jar-image', loading: 'lazy', alt: section.settings.heading }}
    {% else %}
      <img src="{{ 'pepper jar.png' | asset_url }}" alt="{{ section.settings.heading }}" class="hero__jar-image" loading="lazy" width="512" height="768">
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Taggart Family Farm"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Hot Pepper Spread"},
    {"type": "textarea", "id": "text", "label": "Lead copy", "default": "A sweet heat made from sun-ripened peppers, local honey, and just enough smoke."},
    {"type": "image_picker", "id": "background", "label": "Background image"},
    {"type": "image_picker", "id": "jar_image", "label": "Feature jar image"},
    {"type": "color", "id": "overlay_color", "label": "Overlay color", "default": "rgba(15,7,0,0.65)"},
    {"type": "text", "id": "primary_label", "label": "Primary button", "default": "Shop Hot Pepper Spread"},
    {"type": "text", "id": "primary_link", "label": "Primary link", "default": "/products/hot-pepper-spread"},
    {"type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Our Story"},
    {"type": "text", "id": "secondary_link", "label": "Secondary link", "default": "/pages/our-story"}
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {"type": "text", "id": "label", "label": "Label", "default": "Heat Level"},
        {"type": "text", "id": "value", "label": "Value", "default": "Medium-Hot"}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {"type": "stat"},
        {"type": "stat"}
      ]
    }
  ]
}
{% endschema %}
