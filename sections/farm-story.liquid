<section class="farm-story">
  <div class="farm-story__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'farm-story__image', loading: 'lazy', alt: section.settings.heading }}
    {% endif %}
  </div>
  <div class="farm-story__content">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
    {% if section.settings.button_label != blank %}
      <a class="button button--ghost" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Farm story",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Farm-grown heat"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Meet the Taggart family"},
    {"type": "richtext", "id": "text", "label": "Body", "default": "<p>We plant, harvest, and cook every batch on our family farm just outside Spokane, WA. The result? A fiery spread with the soul of the land.</p>"},
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Read our story"},
    {"type": "text", "id": "button_link", "label": "Button link", "default": "/pages/our-story"}
  ],
  "presets": [
    {"name": "Farm story"}
  ]
}
{% endschema %}
