        <svg width="14" height="14" viewBox="0 0 20 20" fill="#D99A3C" stroke="#D99A3C" stroke-width="1.5"><path d="M 10 2 L 12.5 7.5 L 18 8.2 L 14 12 L 15 18 L 10 15 L 5 18 L 6 12 L 2 8.2 L 7.5 7.5 Z"/></svg>
        <svg width="14" height="14" viewBox="0 0 20 20" fill="#D99A3C" stroke="#D99A3C" stroke-width="1.5"><path d="M 10 2 L 12.5 7.5 L 18 8.2 L 14 12 L 15 18 L 10 15 L 5 18 L 6 12 L 2 8.2 L 7.5 7.5 Z"/></svg>
