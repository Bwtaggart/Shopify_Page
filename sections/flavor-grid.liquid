<section class="flavor-grid">
  <div class="flavor-grid__intro">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
  <div class="flavor-grid__items">
    {% for block in section.blocks %}
      <article class="flavor-card">
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.copy }}</p>
        <span class="flavor-card__note">{{ block.settings.note }}</span>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Flavor callouts",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why it sells out"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Bold, bright, and balanced"},
    {"type": "textarea", "id": "text", "label": "Description", "default": "From pantry staple to crowd-pleaser, this spread brings a little sun to every bite."}
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {"type": "text", "id": "title", "label": "Title", "default": "Smoky heat"},
        {"type": "textarea", "id": "copy", "label": "Copy", "default": "Hickory smoke coaxes out savory depth without overpowering the fruit."},
        {"type": "text", "id": "note", "label": "Note", "default": "Heat 6/10"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Flavor callouts",
      "blocks": [
        {"type": "card"},
        {"type": "card"},
        {"type": "card"}
      ]
    }
  ]
}
{% endschema %}
