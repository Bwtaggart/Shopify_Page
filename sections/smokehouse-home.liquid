        <div style="font-family:var(--sm-f-display); font-size:26px; color:var(--sm-cream); margin-top:8px">Six · nothing else</div>
      </div>
      <div>
        <div class="sm-eye" style="font-size:10px">Reviews</div>
        <div style="font-family:var(--sm-f-display); font-size:26px; color:var(--sm-cream); margin-top:8px">5.0 ★ · five-star</div>
      </div>
    </div>
  </div>
</section>

<!-- MARQUEE STRIP -->
<section style="background:var(--sm-panel); padding:18px 76px; border-top:1px solid var(--sm-line); border-bottom:1px solid var(--sm-line)">
