        <div style="font-family:var(--sm-f-ui); font-size:11px; letter-spacing:2px; color:var(--sm-gold)">05</div>
        <div style="font-family:var(--sm-f-display); font-size:21px; margin-top:10px; color:var(--sm-cream)">Roasted garlic</div>
        <div style="font-size:14px; margin-top:6px; color:var(--sm-cream-dim)">Soft-neck, peeled</div>
