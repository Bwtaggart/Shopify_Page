<!-- WHOLESALE CTA -->
<section style="padding:0 76px 110px">
  <div style="background:linear-gradient(120deg, var(--sm-pepper), var(--sm-rust)); border-radius:10px; padding:64px; display:grid; grid-template-columns:1.2fr 1fr; gap:56px; align-items:center; position:relative; overflow:hidden; border:1px solid var(--sm-line)">
    <div style="position:absolute; right:-80px; top:-80px; width:320px; height:320px; border-radius:50%; background:rgba(231,190,98,0.16)"></div>
    <div style="position:relative">
      <div class="sm-eye" style="color:var(--sm-gold-light)">Wholesale &amp; gifting</div>
      <h2 style="font-family:var(--sm-f-display); font-size:46px; line-height:1.08; margin:16px 0 18px; font-weight:700; color:var(--sm-cream)">Need a lot of jars?</h2>
      <p style="font-size:19px; line-height:1.55; color:rgba(248,239,217,0.92); max-width:420px">Wedding favors, corporate gifts, store shelves — we pack pallets the same way we pack jars: by hand.</p>
    </div>
    <div style="position:relative; background:var(--sm-cream); border-radius:8px; padding:32px; color:var(--sm-ink)">
      <form action="/pages/contact" method="get">
        <div style="margin-bottom:16px">
          <div style="font-family:var(--sm-f-ui); font-size:10px; letter-spacing:2px; color:var(--sm-pepper); font-weight:600; text-transform:uppercase">Name</div>
          <input type="text" placeholder="Your name" style="width:100%; font-size:16px; color:#6B4A33; padding:10px 0; border:none; border-bottom:1px solid rgba(43,26,18,0.16); background:transparent; outline:none; font-family:var(--sm-f-body)">
        </div>
        <div style="margin-bottom:16px">
          <div style="font-family:var(--sm-f-ui); font-size:10px; letter-spacing:2px; color:var(--sm-pepper); font-weight:600; text-transform:uppercase">Email</div>
          <input type="email" placeholder="you@email.com" style="width:100%; font-size:16px; color:#6B4A33; padding:10px 0; border:none; border-bottom:1px solid rgba(43,26,18,0.16); background:transparent; outline:none; font-family:var(--sm-f-body)">
        </div>
        <div style="margin-bottom:16px">
          <div style="font-family:var(--sm-f-ui); font-size:10px; letter-spacing:2px; color:var(--sm-pepper); font-weight:600; text-transform:uppercase">Inquiry</div>
          <input type="text" placeholder="Wholesale · 144 jars" style="width:100%; font-size:16px; color:#6B4A33; padding:10px 0; border:none; border-bottom:1px solid rgba(43,26,18,0.16); background:transparent; outline:none; font-family:var(--sm-f-body)">
        </div>
        <button type="submit" class="sm-btn sm-btn-primary" style="width:100%; justify-content:center; margin-top:8px"><span>Send Inquiry</span><span class="sm-btn-arrow">→</span></button>
      </form>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer style="background:#2C1509; color:var(--sm-cream); padding:76px 76px 40px; font-family:var(--sm-f-body); border-top:1px solid var(--sm-line)">
  <div style="display:grid; grid-template-columns:1.6fr 1fr 1fr 1.3fr; gap:48px; padding-bottom:44px; border-bottom:1px solid var(--sm-line)">
    <div>
      <div style="display:flex; align-items:center; gap:12px">
        <img src="https://cdn.shopify.com/s/files/1/0787/2010/6751/files/taggart-logo-hi-res.png?v=1763828798&width=100" alt="Taggart Family Farm" width="50" height="50" style="display:block; width:50px; height:50px">
        <div style="font-family:var(--sm-f-display); font-weight:700; font-size:22px; letter-spacing:0.06em">TAGGART</div>
      </div>
      <p style="margin-top:18px; font-size:16px; line-height:1.6; color:var(--sm-cream-dim); max-width:320px">A small family farm in Nokesville, Virginia, cooking the pepper spread Bryan's family has made for generations.</p>
    </div>
    <div>
      <div class="sm-eye" style="font-size:11px">Shop</div>
      <ul style="list-style:none; margin:18px 0 0; display:grid; gap:11px; font-size:16px; color:var(--sm-cream-dim)">
        <li><a href="/products/pepper-spread-hot" style="color:var(--sm-cream-dim)">Hot Pepper Spread (16 oz)</a></li>
        <li><a href="/products/pepper-spread-mild" style="color:var(--sm-cream-dim)">Mild Spread (8 oz)</a></li>
        <li><a href="/collections/all" style="color:var(--sm-cream-dim)">All Products</a></li>
      </ul>
    </div>
    <div>
      <div class="sm-eye" style="font-size:11px">Kitchen</div>
      <ul style="list-style:none; margin:18px 0 0; display:grid; gap:11px; font-size:16px; color:var(--sm-cream-dim)">
        <li><a href="/pages/recipes" style="color:var(--sm-cream-dim)">All Recipes</a></li>
        <li><a href="/pages/recipes" style="color:var(--sm-cream-dim)">Pizza Night</a></li>
        <li><a href="/pages/recipes" style="color:var(--sm-cream-dim)">Quick Apps</a></li>
        <li><a href="/pages/recipes" style="color:var(--sm-cream-dim)">Pairings</a></li>
      </ul>
    </div>
    <div>
      <div class="sm-eye" style="font-size:11px">The newsletter</div>
      <p style="margin-top:14px; font-size:15px; line-height:1.55; color:var(--sm-cream-dim)">Recipes, farm notes, and first crack at new flavors.</p>
      {%- form 'customer', id: 'smokehouse-newsletter' -%}
        <div style="display:flex; margin-top:16px; border:1px solid var(--sm-gold); border-radius:2px; overflow:hidden">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="you@email.com" required style="flex:1; padding:11px 16px; font-size:15px; color:var(--sm-cream-dim); background:transparent; border:none; outline:none; font-family:var(--sm-f-body)">
          <button type="submit" style="padding:11px 20px; background:var(--sm-gold); color:var(--sm-ink); font-family:var(--sm-f-ui); font-weight:700; font-size:11px; letter-spacing:1.4px; text-transform:uppercase; cursor:pointer; border:none">Join</button>
        </div>
      {%- endform -%}
    </div>
  </div>
  <div style="display:flex; justify-content:space-between; padding-top:26px; font-family:var(--sm-f-ui); font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--sm-cream-dim)">
    <span>&copy; {{ 'now' | date: '%Y' }} Taggart Family Farm</span>
    <span style="display:flex; gap:22px"><a href="https://www.instagram.com/taggartfamilyfarm" target="_blank" rel="noopener" style="color:var(--sm-cream-dim)">Instagram</a><a href="https://www.facebook.com/taggartfamilyfarm" target="_blank" rel="noopener" style="color:var(--sm-cream-dim)">Facebook</a></span>
  </div>
</footer>

</div>

