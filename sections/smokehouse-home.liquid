{{ 'smokehouse.css' | asset_url | stylesheet_tag }}


<div class="smokehouse-home">

<!-- HEADER -->
<header style="display:grid; grid-template-columns:1fr auto 1fr; align-items:center; padding:24px 76px; border-bottom:1px solid var(--sm-line)">
  <nav style="display:flex; gap:30px; font-family:var(--sm-f-ui); font-size:12px; font-weight:500; letter-spacing:0.18em; text-transform:uppercase">
    <a href="/collections/all" style="color:var(--sm-cream)">Shop</a>
    <a href="/pages/recipes" style="color:var(--sm-cream)">Recipes</a>
    <a href="/pages/our-story" style="color:var(--sm-cream)">Story</a>
  </nav>
  <a href="/" style="display:flex; align-items:center; gap:12px; justify-self:center">
    <img src="https://cdn.shopify.com/s/files/1/0787/2010/6751/files/taggart-logo-hi-res.png?v=1763828798&width=88" alt="Taggart Family Farm" width="44" height="44" style="display:block; width:44px; height:44px">
    <div style="line-height:1">
      <div style="font-family:var(--sm-f-display); font-weight:700; font-size:21px; letter-spacing:0.06em; color:var(--sm-cream)">TAGGART</div>
      <div style="font-family:var(--sm-f-display); font-weight:500; font-size:8px; letter-spacing:0.38em; color:var(--sm-cream-dim); margin-top:3px">FAMILY&nbsp;FARM</div>
    </div>
  </a>
  <div style="display:flex; gap:22px; justify-content:flex-end; align-items:center; font-family:var(--sm-f-ui); font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:var(--sm-cream)">
    <a href="/search" style="color:var(--sm-cream)">Search</a>
    <a href="{{ routes.cart_url }}" style="padding:9px 18px; border-radius:2px; border:1.5px solid var(--sm-gold); color:var(--sm-gold-light); font-weight:600">Cart · {{ cart.item_count }}</a>
  </div>
</header>

<!-- HERO -->
<section style="padding:64px 76px 90px; position:relative; overflow:hidden">
  <div style="position:absolute; top:-80px; left:50%; transform:translateX(-50%); width:760px; height:760px; border-radius:50%; background:radial-gradient(circle, rgba(217,154,60,0.13), transparent 64%); pointer-events:none"></div>
  <div style="position:relative; text-align:center; display:flex; flex-direction:column; align-items:center">
    <img src="https://cdn.shopify.com/s/files/1/0787/2010/6751/files/taggart-logo-hi-res.png?v=1763828798&width=184" alt="Taggart Family Farm" width="92" height="92" style="display:block; width:92px; height:92px">
    <div class="sm-eye" style="margin-top:22px">Nokesville, Virginia · Small batch</div>
    <h1 style="font-family:var(--sm-f-display); font-size:80px; line-height:1.04; margin:20px 0 0; font-weight:700; letter-spacing:0.01em">
      HOT PEPPER<br><span style="color:var(--sm-gold-light)">SPREAD</span>
    </h1>
    <p style="font-size:21px; line-height:1.55; color:var(--sm-cream-dim); max-width:540px; margin-top:24px">
      A sweet heat made from sun-ripened peppers, local honey, and just enough smoke — cooked in small batches and hand-filled on the family farm.
    </p>
    <div style="display:flex; gap:14px; margin-top:34px; align-items:center">
      <a href="/products/pepper-spread-hot" class="sm-btn sm-btn-primary"><span>Shop the Spread · $15</span><span class="sm-btn-arrow">→</span></a>
      <a href="/pages/our-story" class="sm-btn"><span>Our Story</span><span class="sm-btn-arrow">→</span></a>
    </div>
  </div>

  <!-- Jar + stat band -->
  <div style="margin-top:70px; position:relative; border:1px solid var(--sm-line); border-radius:8px; padding:0 56px; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; min-height:360px; background:var(--sm-base)">
